{
  "name": "bn-tracing",
  "version": "0.2.0",
  "description": "Tracing with Opentelemetry and Google Cloud Trace via OTLP",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "rollup index.js --format cjs --file index.cjs"
  },
  "exports": {
    "import": "./index.js",
    "require": "./index.cjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/resource-detector-gcp": "^0.59.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@bonniernews/eslint-config": "3.0.0",
    "eslint": "9.39.5",
    "rollup": "4.63.1"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "package-lock.json",
    "package.json",
    "index.js",
    "index.cjs"
