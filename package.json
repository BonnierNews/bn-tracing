{
  "name": "bn-tracing",
  "version": "0.1.0",
  "description": "Tracing with Opentelemetry and Google Trace Exporter",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "rollup index.js --format cjs --file index.cjs"
  },
  "exports": {
    "import": "./index.js",
    "require": "./index.cjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation": "^0.215.0",
    "@opentelemetry/instrumentation-express": "^0.63.0",
    "@opentelemetry/instrumentation-http": "^0.215.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0"
  },
  "devDependencies": {
    "@bonniernews/eslint-config": "2.0.5",
    "eslint": "8.57.1",
    "rollup": "4.52.0"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "package-lock.json",
    "package.json",
    "index.js",
    "index.cjs"
  ]
}
